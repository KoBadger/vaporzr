# Off-site backup target for deploy/backup-offsite.sh.
#
# Install as /etc/vaporzr/backup.env with mode 600 (root only):
#   install -m 600 deploy/backup.env.example /etc/vaporzr/backup.env
#
# Any S3-compatible store works. Both of these have a free tier large enough
# for this volume (a few hundred MB after the rebuildable caches are excluded):
#
#   Cloudflare R2   s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#                   AWS_DEFAULT_REGION=auto
#   Backblaze B2    s3:https://s3.<region>.backblazeb2.com/<bucket>
#                   AWS_DEFAULT_REGION=<region>
#
# R2: create the bucket, then an API token with Object Read & Write on it.
# B2: create the bucket, then an application key scoped to that bucket.
#
# Values with spaces must be quoted (bash sources this file).

RESTIC_REPOSITORY=
RESTIC_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Optional: pin the restic image instead of the default.
# RESTIC_IMAGE=restic/restic:0.17.3
