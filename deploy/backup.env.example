# Backup configuration for deploy/backup.sh.
#
# Install as /etc/vaporzr/backup.env with mode 600 (root only):
#   install -m 600 deploy/backup.env.example /etc/vaporzr/backup.env
#
# Pick ONE (or both) off-site targets. Nothing here needs inbound access: the
# VPS pushes out.
#
#   A) restic → S3-compatible bucket — incremental, deduplicated, best automation.
#      Cloudflare R2 and Backblaze B2 both want a card on file, even at €0 spend.
#        R2:  s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#             AWS_DEFAULT_REGION=auto
#        B2:  s3:https://s3.<region>.backblazeb2.com/<bucket>
#             AWS_DEFAULT_REGION=<region>
#
#   B) GitHub Release asset — no payment method at all. Encrypted archive,
#      pruned to the newest few. See docs/BACKUPS.md.
#
# Values with spaces must be quoted (bash sources this file).

# --- A) restic target -------------------------------------------------------
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Optional: pin the restic image instead of the default.
# RESTIC_IMAGE=restic/restic:0.17.3

# --- B) GitHub Releases target ---------------------------------------------
# Private repo that holds only ciphertext, e.g. owner/vaporzr-backups
GH_BACKUP_REPO=
# Classic token with `repo` scope, or fine-grained with Contents: read+write.
GH_BACKUP_TOKEN=
# Assets to keep (default 6).
# GH_BACKUP_KEEP=6

# --- Heartbeat --------------------------------------------------------------
# healthchecks.io check URL (https://hc-ping.com/<uuid>). Success pings it;
# failure pings <url>/fail. Omit to skip.
BACKUP_HEALTHCHECK_URL=

# --- Encryption -------------------------------------------------------------
# Passphrase for the openssl-encrypted GitHub archive. Generate one with
# `openssl rand -base64 32`, store it in a password manager, and keep a copy
# here. If this file exists only on the VPS, the backups die with the VPS.
# BACKUP_PASSPHRASE_FILE=/opt/vaporzr/backup-passphrase.txt
