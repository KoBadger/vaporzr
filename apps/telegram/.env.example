# Telegram front end. Copy to .env and fill in. Never commit .env.

# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Control credential for the running Vaporzr bot (its SHARE_KEY or MASTER_PASSWORD).
VAPORZR_KEY=

# Where the bot listens. Loopback when this runs on the same host (or with
# --network host); http://bot:4876 inside the compose project.
VAPORZR_URL=http://127.0.0.1:4876

# Optional: public HTTPS panel URL. Adds an "Open panel" button and the Web App
# menu button. Must be HTTPS or Telegram rejects it.
TELEGRAM_PANEL_URL=

# Optional: comma-separated chat ids allowed to use the bot. Empty = everyone.
TELEGRAM_ALLOWED_CHATS=

# Optional tuning.
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_STATE_PATH=./data/telegram-state.json
