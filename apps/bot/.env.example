# Discord application token
DISCORD_TOKEN=

# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The redirect URI you registered in the Spotify dashboard MUST match this.
# If you change PORT, update the redirect URI in the Spotify dashboard too.
PORT=4876
SPOTIFY_REDIRECT_URI=http://localhost:4876/callback

# Optional: your Discord user ID so the bot can address you as the owner.
# If unset, the bot auto-detects the Discord application owner at startup.
OWNER_ID=

# Optional: persistent data directory for queue files, librespot cache, etc.
# DATA_DIR=

# Optional: hostname advertised in /viz, /panel, and /help links.
# Defaults to this machine's LAN IP (reachable from other devices on your
# network). Set a custom domain if you run the bot behind port forwarding.
# PUBLIC_HOST=

# --- Secure visualizer links (automatic HTTPS tunnel) ---
# The bot runs a Cloudflare quick tunnel so /viz + /panel links open as
# trusted https:// URLs (no "Not secure" warning). No account needed; the
# subdomain is random per run. Set VIZ_TUNNEL=off to disable and use LAN links.
# VIZ_TUNNEL=off
# Advanced: use a NAMED tunnel with your own branded domain (e.g. viz.vaporzr.app).
# Paste the connector token from the Cloudflare Zero Trust dashboard:
#   cloudflared tunnel run --token <TOKEN>
# TUNNEL_TOKEN=
# CLOUDFLARED_PATH=<repo>/vendor/cloudflared/cloudflared

# Play Spotify requests through YouTube instead of the (single, shared) librespot
# device. Required for multi-server use so per-guild sessions never contend for
# one Spotify device. Set to 1 to enable.
#
# NOTE: this project now runs NATIVE Spotify via librespot on the VPS
# (SPOTIFY_PREFER_YOUTUBE=0) — see the --cache / --enable-oauth notes below.
# SPOTIFY_PREFER_YOUTUBE=0

# YouTube Data API v3 key (enables /yt search). Optional but recommended.
YOUTUBE_API_KEY=

# Optional: override path to the yt-dlp binary.
# Defaults to <repo>/vendor/yt-dlp/yt-dlp
YT_DLP_PATH=

# Optional: Netscape-format cookies.txt for YouTube. Authenticated yt-dlp
# requests avoid most 403s and throttling that cause mid-track stream cuts.
# Export from your browser with an extension like "Get cookies.txt LOCALLY",
# or run `/cookie-refresh confirm:true` on a machine with a browser to
# re-export cookies automatically.
# YOUTUBE_COOKIES_PATH=

# Optional: proxy hops for YouTube traffic (format http://[user:pass@]host:port).
# Tried AFTER the direct connection, in order: YOUTUBE_PROXY (optional first hop;
# the old clean-IP bridge) → YOUTUBE_PROXY_ALT (free second egress — the intended
# deployment is a local Cloudflare WARP proxy, http://127.0.0.1:40000) →
# YOUTUBE_PROXY_FALLBACK (last-resort metered residential, spent only when both
# free routes fail). Datacenter IPs can be SABR-flagged by YouTube; a residential
# exit restores resolution AND playback. Empty entries are skipped.
# YOUTUBE_PROXY=
# YOUTUBE_PROXY_ALT=
# YOUTUBE_PROXY_FALLBACK=

# Optional: how the FIRST hop is named in the hop-down alert (e.g. "your PC").
# The WARP and residential hops are named with fixed wording.
# YOUTUBE_PROXY_LABEL=

# Optional: override path to ffmpeg. Defaults to the bundled ffmpeg-static.
# FFMPEG_PATH=

# --- Server-side playback (librespot) ---
# Path to the librespot executable. Defaults to <repo>/vendor/librespot/librespot
# (set LIBRESPOT_PATH to override). When available, the bot becomes its own Spotify
# device and streams directly to the voice channel — no local web player required.
# Spotify tracks fall back to a YouTube search if librespot is missing or can't start.
LIBRESPOT_PATH=
# In the container (Dockerfile) the binary is baked in at /usr/local/bin/librespot,
# so production .env sets LIBRESPOT_PATH=/usr/local/bin/librespot.
# LIBRESPOT_DEVICE_NAME=Vaporzr
# Bitrate librespot requests (320 = Premium only).
# LIBRESPOT_BITRATE=320
# librespot >= 0.8.0 does NOT support password login — it uses OAuth. Authorize
# once so credentials are cached in <repo>/apps/bot/data/librespot:
#   vendor/librespot/librespot --cache <repo>/apps/bot/data/librespot --enable-oauth
# (opens your browser, log in with the bot's Spotify account, approve, done.)
# Rename the Connect device live with `/device select <name>` (restarts librespot).

# --- Voice audio quality (Opus encoding) ---
# Discord's default channel bitrate is 64 kbps and the bot used to encode at
# libopus's own default (~64 kbps) no matter what the channel allowed. The bot
# now encodes at the channel's real ceiling: 96 kbps on a free server, then
# 128 / 256 / 384 with boost levels 1 / 2 / 3. Check `/diag` -> Opus.
# Force a specific bitrate in bits/s instead of the channel maximum.
# VOICE_OPUS_BITRATE=256000
# Raise the voice channel to the guild's cap on join (needs Manage Channels).
# Set to 0 if the bot should never edit channel settings.
# VOICE_RAISE_CHANNEL_BITRATE=1
# In-band FEC on the music stream: a little redundancy against packet loss.
# VOICE_OPUS_FEC=1
# native = @discordjs/opus, sending pre-encoded Opus (best quality).
# off = old path: raw PCM into @discordjs/voice (~64 kbps, capped at 128).
# VOICE_OPUS_ENCODER=native

# --- Spotify anonymous token (optional) ---
# Use the anonymous web-player token for public Spotify data (no app quota).
# Disable if you have your own Spotify OAuth set up.
# SPOTIFY_USE_ANONYMOUS=true
# sp_dc session cookie from open.spotify.com — unlocks full-length resolution
# of any public playlist. Obtain from browser DevTools > Application > Cookies.
# SPOTIFY_SP_DC=
# TOTP secret for the web-player token endpoint (advanced — only needed if
# Spotify rotates the default or you have your own token setup).
# SPOTIFY_TOTP_SECRET=
# SPOTIFY_TOTP_VER=5

# --- Electron player window (optional) ---
# PLAYER_DIR=apps/player
# ELECTRON_PATH=

# Permanent public base URL (Tailscale Funnel / custom domain). Overrides all other link modes.
# PUBLIC_BASE_URL=https://vaporzr-bot.your-tailnet.ts.net

# Master key for the whole web tier (panel, visualizer, listener). Enter it
# once per device, or prefer the expiring invites from /key give. Empty = no gate.
# SHARE_KEY=some-share-key

# Web exposure: public (default) or tailnet. tailnet refuses the public tunnel
# host entirely - only loopback, Tailscale addresses and *.ts.net names answer.
# WEB_ACCESS=public

# --- Jam sharing (/jam, /request, the panel's 📱 Share button) ---
# Separate LOW-privilege key for the guest jam page: whoever holds it can
# request songs and watch the queue — never control playback. The /jam card
# (QR + link) embeds this key, so keep it different from SHARE_KEY.
# Legacy fallback only: new /jam cards mint expiring, revocable request invites.
# REQUEST_KEY=

# Public base URL used for the jam join link + QR (e.g. https://vaporzr.example.com).
# Required for /jam and the panel's Share button; without it both point at a
# client-derived address, which only works on the host machine itself.
# JAM_PUBLIC_BASE=

# --- Mashup stem separation speed ---
# Hosted GPU stem separation via Replicate Demucs (~2 cents/song, ~80s) instead of
# the local CPU Demucs (~29 min/song). Get a token at https://replicate.com.
# Without this, V@mashup skips stems and posts a fast beat/key-matched blend.
# REPLICATE_API_TOKEN=
# REPLICATE_DEMUCS_MODEL=cjwbw/demucs
# REPLICATE_DEMUCS_VERSION=
# Opt back into the slow local CPU Demucs run when no Replicate token is set.
# STEMS_LOCAL_DEMUCS=1
