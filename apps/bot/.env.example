# Discord application token
DISCORD_TOKEN=

# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The redirect URI you registered in the Spotify dashboard MUST match this.
# If you change PORT, update the redirect URI in the Spotify dashboard too.
PORT=4876
SPOTIFY_REDIRECT_URI=http://localhost:4876/callback

# Optional: your Discord user ID so the bot can address you as the owner.
# If unset, the bot auto-detects the Discord application owner at startup.
OWNER_ID=

# Optional: persistent data directory for queue files, librespot cache, etc.
# DATA_DIR=

# Play Spotify requests through YouTube instead of the (single, shared) librespot
# device. Required for multi-server use so per-guild sessions never contend for
# one Spotify device. Set to 1 to enable.
# SPOTIFY_PREFER_YOUTUBE=1

# YouTube Data API v3 key (enables /yt search). Optional but recommended.
YOUTUBE_API_KEY=

# Optional: override path to the yt-dlp binary.
# Defaults to <repo>/vendor/yt-dlp/yt-dlp.exe
YT_DLP_PATH=

# Optional: override path to ffmpeg. Defaults to the bundled ffmpeg-static.
# FFMPEG_PATH=

# --- Server-side playback (librespot) ---
# Path to the librespot executable. Defaults to <repo>/vendor/librespot/librespot.exe
# (set LIBRESPOT_PATH to override). When available, the bot becomes its own Spotify
# device and streams directly to the voice channel — no local web player required.
# Spotify tracks fall back to a YouTube search if librespot is missing or can't start.
LIBRESPOT_PATH=
# LIBRESPOT_DEVICE_NAME=Vaporzr
# librespot >= 0.8.0 does NOT support password login — it uses OAuth. Authorize
# once so credentials are cached in <repo>/apps/bot/data/librespot:
#   vendor\librespot\librespot.exe --cache <repo>\apps\bot\data\librespot --enable-oauth
# (opens your browser, log in with the bot's Spotify account, approve, done.)
# LIBRESPOT_BRIDGE_PORT=4789
# Bitrate librespot requests (320 = Premium only).
# LIBRESPOT_BITRATE=320

# --- Spotify anonymous token (optional) ---
# Use the anonymous web-player token for public Spotify data (no app quota).
# Disable if you have your own Spotify OAuth set up.
# SPOTIFY_USE_ANONYMOUS=true
# sp_dc session cookie from open.spotify.com — unlocks full-length resolution
# of any public playlist. Obtain from browser DevTools > Application > Cookies.
# SPOTIFY_SP_DC=
# TOTP secret for the web-player token endpoint (advanced — only needed if
# Spotify rotates the default or you have your own token setup).
# SPOTIFY_TOTP_SECRET=
# SPOTIFY_TOTP_VER=5

# --- Electron player window (optional) ---
# PLAYER_DIR=apps/player
# ELECTRON_PATH=
